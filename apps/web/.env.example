# Public, non-secret local values. Copy to .env.local when necessary.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_REALTIME_HTTP_ORIGIN=http://localhost:8787
NEXT_PUBLIC_REALTIME_WS_ORIGIN=ws://localhost:8787

# Server-only local values. Generate a different secret for every environment.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-high-entropy-characters
CF_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-the-64-character-application-audience-tag
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
