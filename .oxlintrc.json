{
  "categories": {
    "correctness": "error",
    "perf": "warn",
    "suspicious": "error"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/.next/**",
    "**/.vinext/**",
    "**/.wrangler/**",
    "**/worker-configuration.d.ts"
  ],
  "plugins": [
    "typescript"
  ],
  "rules": {
    "typescript/no-floating-promises": "error"
  }
}
